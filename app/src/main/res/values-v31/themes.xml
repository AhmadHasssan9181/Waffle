<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows the launcher icon as a splash screen; give it the real brand mark
         on the same cream instead of the default app icon on white. -->
    <style name="Theme.Waffle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_waffle_mark</item>
    </style>
</resources>
